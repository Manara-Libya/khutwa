        "properties": {
          "situation": {
            "items": {
              "type": "string",
              "enum": [
                "study_pressure",
                "family_tension",
                "loneliness",
                "low_mood_sleep_worry",
                "loss_displacement",
                "harassment"
              ]
            },
            "type": "array",
            "title": "Situation",
            "default": []
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"

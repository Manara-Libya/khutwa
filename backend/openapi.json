    "/v1/chat/completions": {
      "post": {
        "tags": [
          "openai-compatible"
        ],
        "summary": "Chat completions (OpenAI format, supports stream=true)",
        "description": "Runs the `khutwa-chat` agent, whose safety rules override the conversation. `temperature` and `max_tokens` are accepted but ignored.",
        "operationId": "chat_completions_v1_chat_completions_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],

  },
  "components": {
    "schemas": {
      "AnalyzeIn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "description": "User text **after on-device redaction**. Never send raw identifiers.",
            "examples": [
              "rani ta3bana barsha min el imti7anat w el 7osh kollah mashakel"
            ]
          },
          "history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Turn"
                },
                "type": "array",
                "maxItems": 12
              },
              {
                "type": "null"
              }
            ],
            "title": "History",
            "description": "Earlier turns of this conversation, oldest first, **redacted on the phone** like `text`. The phone keeps them in memory and sends them with each message; the server stores nothing. When `history` is sent (even empty), suggestions are held back until the user's 3th message or until they ask who to talk to (`support_ready`). Omit it for the old behaviour (suggestions on every message)."
          },
          "defer_support": {
            "type": "boolean",
            "title": "Defer Support",
            "description": "When true, /v1/analyze does not wait for the support options: it returns the reply as soon as it is ready, with support_ready set, and the app fetches the options from /v1/support.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AnalyzeIn"
      },
      "AnalyzeOut": {
        "properties": {
          "urgent": {
            "type": "boolean",
            "title": "Urgent",
            "description": "True: stop and show the fixed urgent-help screen. No AI text is returned."
          },
          "risk": {
            "type": "string",
            "enum": [
              "none",
              "possible",
              "high",
              "unknown"
            ],
            "title": "Risk"
          },
          "reflection": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reflection"
          },
          "situation": {
            "items": {
              "type": "string",
              "enum": [
                "study_pressure",
                "family_tension",
                "loneliness",
                "low_mood_sleep_worry",
                "loss_displacement",
                "harassment"
              ]
            },
            "type": "array",
            "title": "Situation",
            "default": []
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "type": "array",
            "title": "Suggestions",
            "default": []
          },
          "fallback": {
            "type": "boolean",
            "title": "Fallback",
            "default": false
          },
          "support_ready": {
            "type": "boolean",
            "title": "Support Ready",
            "description": "False while Khutwa is still listening: no support options yet, keep the conversation going. True: show the support options (`suggestions`, or the generic ones if empty).",
            "default": true
          },
          "a2ui": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "A2Ui",
            "description": "A2UI v0.8 messages (surfaceUpdate, dataModelUpdate, beginRendering) that render the support options inline: a card per option with its reason, the editable draft and send-it-yourself / copy buttons. Built by the server from validated suggestions; empty until support_ready.",
            "default": []
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          }
        },
        "type": "object",
        "required": [
          "urgent",
          "risk",
          "elapsed_ms"
        ],
        "title": "AnalyzeOut"
      },
      "ChatCompletionRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "gemini-3.8-flash-low",
            "examples": [
              "gemini-3.8-flash-low"
            ]
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Messages"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature",
            "description": "Accepted for compatibility; ignored."
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens",
            "description": "Accepted for compatibility; ignored."
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatCompletionRequest"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 2000,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "DevPrompt": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 20,
            "title": "Prompt"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "DevPrompt"
      },
      "DevTryIn": {
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "risk",
              "reflect",
              "suggest"
            ],
            "title": "Task"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Defaults to the task's preferred model."
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt",
            "description": "Draft prompt body to try. Omit to use the live prompt."
          },
          "history": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Turn"
                },
                "type": "array",
                "maxItems": 12
              },
              {
                "type": "null"
              }
            ],
            "title": "History",
            "description": "Earlier turns, to try a prompt in the middle of a conversation."
          }
        },
        "type": "object",
        "required": [
          "task",
          "text"
        ],
        "title": "DevTryIn"
      },
      "DevTryOut": {
        "properties": {
          "raw": {
            "type": "string",
            "title": "Raw"
          },
          "parsed": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parsed"
          },
          "valid": {
            "type": "boolean",
            "title": "Valid",
            "description": "Parsed and matched the task's JSON schema."
          },
          "guardrail": {
            "type": "boolean",
            "title": "Guardrail",
            "description": "True if the output contains a blocked term (diagnosis, medication...)."
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          }
        },
        "type": "object",
        "required": [
          "raw",
          "parsed",
          "valid",
          "guardrail",
          "model",
          "elapsed_ms"
        ],
        "title": "DevTryOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"

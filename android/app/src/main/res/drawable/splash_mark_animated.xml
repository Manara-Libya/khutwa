<?xml version="1.0" encoding="utf-8"?>
<!-- The splash: the small stone drops in and lands, then the green stone grows in from a slight tilt and settles.
     About 900 ms, matching windowSplashScreenAnimationDuration. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_mark">
    <target android:name="dark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateY" android:valueFrom="-46" android:valueTo="0"
                    android:duration="520" android:startOffset="60" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="-16" android:valueTo="0"
                    android:duration="520" android:startOffset="60" android:interpolator="@android:interpolator/decelerate_cubic"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="darkPath">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:duration="260" android:startOffset="60" android:interpolator="@android:interpolator/linear_out_slow_in"/>
        </aapt:attr>
    </target>
    <target android:name="green">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.55" android:valueTo="1"
                    android:duration="560" android:startOffset="300" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.55" android:valueTo="1"
                    android:duration="560" android:startOffset="300" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="-22" android:valueTo="0"
                    android:duration="620" android:startOffset="300" android:interpolator="@android:interpolator/decelerate_cubic"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="greenFill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:duration="240" android:startOffset="300" android:interpolator="@android:interpolator/linear_out_slow_in"/>
        </aapt:attr>
    </target>
    <target android:name="greenEdge">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:duration="240" android:startOffset="300" android:interpolator="@android:interpolator/linear_out_slow_in"/>
        </aapt:attr>
    </target>
</animated-vector>

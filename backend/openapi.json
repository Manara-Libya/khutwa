    "/v1/dev/prompts/{task}": {
      "put": {
        "tags": [
          "developer"
        ],
        "summary": "Save a prompt as live (previous version is backed up) and refresh its workers",
        "operationId": "dev_save_prompt_v1_dev_prompts__task__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "task",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task"
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          },
          {
            "name": "X-Dev-Key",
            "in": "header",

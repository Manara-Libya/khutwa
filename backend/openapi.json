                "family_tension",
                "loneliness",
                "low_mood_sleep_worry",
                "loss_displacement",
                "harassment"
              ]
            },
            "type": "array",
            "title": "Situation"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
